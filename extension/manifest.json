{
  "manifest_version": 3,
  "name": "i-Courtier — L’IA pour vos pratiques immo",
  "short_name": "i-Courtier",
  "version": "1.1.0",
  "description": "Saisie à la source, ébauches de contrats et administration des inscriptions pour les courtiers immobiliers du Québec. Par i-ateliers.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Ouvrir i-Courtier", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "scripting", "activeTab", "contextMenus"],
  "host_permissions": ["<all_urls>"]
}
