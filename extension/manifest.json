{
  "manifest_version": 3,
  "name": "i-Courtier — L’IA pour vos pratiques immo",
  "short_name": "i-Courtier",
  "version": "2.1.1",
  "description": "Agent IA pour courtiers immobiliers du Québec : saisie à la source, documents, contrats, inscriptions et rédaction.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ouvrir i-Courtier",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Ouvrir i-Courtier"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://i-ateliers.ca/*",
        "https://www.i-ateliers.ca/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://i-ateliers.ca/i-courtier"
}